{
  "name": "uptime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun run src/cli/check.ts",
    "check:local": "INSTANCES_FILE=../degoog/instances.json bun run src/cli/check.ts",
    "export": "bun run src/cli/export.ts",
    "cron": "bun run check && bun run export",
    "dev": "bun run scripts/dev.ts",
    "dev:demo": "bun run scripts/seed-demo.ts && UPTIME_STATUS_PATH=data/demo-status.json UPTIME_DAYS_DIR=data/demo-days bun run scripts/dev.ts",
    "build": "bun run scripts/build.ts",
    "sync:style": "bun run scripts/sync-degoog-style.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "engines": {
    "bun": "1.4.4"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bun-plugin-tailwind": "0.1.2",
    "prettier": "3.9.10",
    "purgecss": "8.0.0",
    "subset-font": "2.9.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
